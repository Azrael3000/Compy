#!/bin/sh
#
# Auto-format staged frontend code (see "Code style" in Readme.md).
#
# Enable once per clone with:
#   git config core.hooksPath tools/git-hooks
#
# - braces around all if/else/loop bodies are added automatically
#   (eslint curly fix + prettier)
# - nested ternary operators cannot be fixed automatically: the commit is
#   blocked and the reported lines have to be rewritten by hand

cd "$(git rev-parse --show-toplevel)/frontend" || exit 1
npx lint-staged
